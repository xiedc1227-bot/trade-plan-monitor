# Project secret-file template. Copy to .env for the default AI configuration;
# the AI loader reads only the file and key named in config/app.yaml.
# Tushare still resolves TUSHARE_TOKEN from the process environment.

TUSHARE_TOKEN=replace-with-your-tushare-token
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# Optional only when profile is changed to OPENAI_COMPATIBLE.
AI_API_KEY=replace-with-another-openai-compatible-api-key
