{
  "name": "trade-plan-monitor-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "setup:test-browser": "python ../scripts/setup_test_browser.py",
    "test": "vitest",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "build:runtime-status-preview": "vite build --config vite.runtime-status.config.ts",
    "build:legacy-test": "vite build --config vite.legacy-test.config.ts"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "axe-core": "4.13.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.10"
  }
}
