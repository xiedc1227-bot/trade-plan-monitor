  "limits": "Read-only diagnostic; profiling/counters are instrumented separate passes, not performance acceptance or native-memory proof. No SQL/authority timing; prebuilt raw and expected output excluded. All passes compare full output.",
  "source": "import cProfile, hashlib, json, pstats, sys, gc\nfrom pathlib import Path\nfrom collections import defaultdict\nfrom time import perf_counter, thread_time\nROOT = Path.cwd()\nsys.path.insert(0, str(ROOT))\nfrom scripts.experiments.c_benchmark import rows_from, CODES\nfrom scripts.experiments import c_validator\nfrom scripts.experiments.bounded_c_producer import Producer\nfrom trade_plan_monitor.state.projections import _latest_index_records\nOUT = ROOT / '.pytest_cache/bep-next-analysis'\nOUT.mkdir(exist_ok=True)\nDB = ROOT / '.pytest_cache/active-monitor-cpu-implementation/monitor.sqlite3'\nsha = hashlib.sha256(DB.read_bytes()).hexdigest()\nrows = rows_from(DB)\nexpected = _latest_index_records(iter(rows), CODES)\nreport = {'inputSha256':sha, 'rows':len(rows), 'maxRawBytes':max(len(r.payload[9]) for r in rows), 'phaseRounds':[], 'profiles':{}}\nfor i in range(3):\n    stages = defaultdict(lambda: {'wall':0.,'cpu':0.,'calls':0})\n    def observe(stage, wall, cpu):\n        stages[stage]['wall'] += wall\n        stages[stage]['cpu'] += cpu\n        stages[stage]['calls'] += 1\n    gc.collect()\n    start, cpu = perf_counter(), thread_time()\n    result = c_validator.latest(iter(rows), CODES, observe)\n    used, wall = thread_time()-cpu, perf_counter()-start\n    assert result == expected\n    report['phaseRounds'].append({'wall':wall, 'cpu':used, 'stages':dict(stages),'equal':True})\n    del result\nfor name, fn in [('original',_latest_index_records),('c256',c_validator.latest)]:\n    profiler = cProfile.Profile()\n    result = profiler.runcall(fn, iter(rows), CODES)\n    assert result == expected\n    stats = pstats.Stats(profiler)\n    selected = []\n    for (file,line,function),(cc,nc,tt,ct,callers) in stats.stats.items():\n        if any(x in file.replace('\\\\','/') for x in ('bounded_c_producer','validator_scan','canonical.py','json/encoder.py')):\n            selected.append({'file':Path(file).name,'line':line,'function':function,'primitiveCalls':cc,'calls':nc,'selfSeconds':tt,'cumulativeSeconds':ct})\n    report['profiles'][name] = {'totalSeconds':stats.total_tt,'functions':sorted(selected,key=lambda r:r['cumulativeSeconds'],reverse=True),'equal':True}\n    del result\ncounters={'traversals':0,'chunks':0,'bytes':0,'calls':0,'maximum':0,'largeRoots':0}\noriginal_pieces = c_validator._namespace['pieces']\ndef counting(value):\n    from scripts.experiments.bounded_c_producer import bound\n    producer=c_validator._producer.get()\n    before=producer.calls\n    counters['traversals']+=1\n    counters['largeRoots']+=int(bound(value)>producer.target)\n    for chunk in producer.pieces(value):\n        counters['chunks']+=1\n        counters['bytes']+=len(chunk)\n        yield chunk\n    counters['calls']+=producer.calls-before\n    counters['maximum']=max(counters['maximum'],producer.maximum)\ntry:\n    c_validator._namespace['pieces']=counting\n    assert c_validator.latest(iter(rows), CODES)==expected\nfinally:\n    c_validator._namespace['pieces']=original_pieces\nreport['producerCounters']=counters\nassert hashlib.sha256(DB.read_bytes()).hexdigest()==sha\nreport['limits']='Read-only diagnostic; profiling/counters are instrumented separate passes, not performance acceptance or native-memory proof. No SQL/authority timing; prebuilt raw and expected output excluded. All passes compare full output.'\nreport['source']=Path(__file__).read_text(encoding='utf-8-sig')\n(OUT/'analysis.json').write_text(json.dumps(report,indent=2),encoding='utf8')\nprint(json.dumps({k:v for k,v in report.items() if k not in ('source','profiles')},indent=2))\nfor name,p in report['profiles'].items():\n    print(name, json.dumps(p['functions'][:12],indent=2))\n",
