    "source": "\"\"\"Read-only diagnostic: equal release endpoints, automatic GC disabled in child only.\"\"\"\nimport argparse\nimport gc\nimport hashlib\nimport json\nimport subprocess\nimport sys\nfrom dataclasses import replace\nfrom pathlib import Path\nfrom statistics import median\nfrom time import perf_counter, thread_time\n\nsys.path.insert(0, str(Path.cwd()))\n\ndef child(args):\n    from scripts.experiments import c_benchmark, failure_boundary, fused_c_validator\n    from trade_plan_monitor.state.projections import ProjectionError\n    path=Path('.pytest_cache/cna-measurements')/(args.shape+'.sqlite3')\n    fingerprint=hashlib.sha256(path.read_bytes()).hexdigest()\n    row,=c_benchmark.rows_from(path)\n    payload=list(row.payload)\n    payload[9]=payload[9].replace(b'\"high_points\":\"1.',b'\"high_points\":\"0.')\n    assert payload[9]!=row.payload[9]\n    invalid=replace(row,payload=tuple(payload))\n    del row,payload\n    # Kept alive and promoted before timing; no artificial cycles in ballast.\n    ballast=[{'items':[]} for _ in range(args.ballast)]\n    gc.collect()\n    gc.disable()\n    def invoke():\n        if args.variant=='boundary':\n            result=failure_boundary._capture(iter((invalid,)),c_benchmark.CODES,lambda *a:None,{})\n            assert isinstance(result,failure_boundary.Failure)\n            return result\n        try:\n            fused_c_validator.latest(iter((invalid,)),c_benchmark.CODES)\n        except ProjectionError as error:\n            return error\n        raise AssertionError('invalid input accepted')\n    start,cpu=perf_counter(),thread_time()\n    held=invoke()\n    validation=dict(wall=perf_counter()-start,cpu=thread_time()-cpu)\n    start,cpu=perf_counter(),thread_time()\n    held=None\n    drop=dict(wall=perf_counter()-start,cpu=thread_time()-cpu)\n    start,cpu=perf_counter(),thread_time()\n    collected=gc.collect(2)\n    cleanup=dict(wall=perf_counter()-start,cpu=thread_time()-cpu,collected=collected)\n    assert len(ballast)==args.ballast and not gc.garbage\n    assert hashlib.sha256(path.read_bytes()).hexdigest()==fingerprint\n    return dict(shape=args.shape,variant=args.variant,ballast=args.ballast,validation=validation,\n        drop=drop,cleanup=cleanup,totalCpu=validation['cpu']+drop['cpu']+cleanup['cpu'],\n        inputSha256=fingerprint,python=sys.version,thresholds=gc.get_threshold())\n\ndef parent():\n    out=Path('.pytest_cache/native-next-gc-results.json')\n    results=[]\n    for shape,ballast in [('decimal',0),('dense',0),('dense',100000)]:\n        for turn in range(3):\n            for variant in (('fused','boundary') if turn%2==0 else ('boundary','fused')):\n                command=[sys.executable,__file__,'--child','--shape',shape,'--ballast',str(ballast),'--variant',variant]\n                run=subprocess.run(command,check=True,capture_output=True,text=True,timeout=90)\n                item=json.loads(run.stdout)\n                item['round']=turn+1\n                results.append(item)\n                out.write_text(json.dumps({'attempts':results},indent=2),encoding='utf8')\n    medians=[]\n    for shape,ballast in [('decimal',0),('dense',0),('dense',100000)]:\n        for variant in ('fused','boundary'):\n            selected=[r for r in results if (r['shape'],r['ballast'],r['variant'])==(shape,ballast,variant)]\n            medians.append(dict(shape=shape,ballast=ballast,variant=variant,\n                validationCpu=median(r['validation']['cpu'] for r in selected),\n                cleanupCpu=median(r['cleanup']['cpu'] for r in selected),\n                totalCpu=median(r['totalCpu'] for r in selected),\n                collected=median(r['cleanup']['collected'] for r in selected)))\n    report=dict(attempts=results,medians=medians,source=Path(__file__).read_text(encoding='utf8'),\n        limitation='3 diagnostic rounds per group, isolated fresh child per call, automatic GC disabled, no tracing; validation+drop+full collection for both paths. Ballast retained/promoted before timing. Not a production GC or concurrent-load benchmark.')\n    out.write_text(json.dumps(report,indent=2),encoding='utf8')\n    print(json.dumps(medians,indent=2))\n\nif __name__=='__main__':\n    p=argparse.ArgumentParser()\n    p.add_argument('--child',action='store_true')\n    p.add_argument('--shape')\n    p.add_argument('--variant')\n    p.add_argument('--ballast',type=int,default=0)\n    args=p.parse_args()\n    if args.child: print(json.dumps(child(args)))\n    else: parent()\n",
    "limitation": "3 diagnostic rounds per group, isolated fresh child per call, automatic GC disabled, no tracing; validation+drop+full collection for both paths. Ballast retained/promoted before timing. Not a production GC or concurrent-load benchmark."
