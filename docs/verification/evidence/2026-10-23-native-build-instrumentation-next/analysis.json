    "source": "import gc,json,sys,tracemalloc\nfrom pathlib import Path\nfrom dataclasses import replace\nsys.path.insert(0,str(Path.cwd()))\nfrom scripts.experiments import c_benchmark,failure_boundary\nresults=[]\nfor shape in ('decimal','dense'):\n    row,=c_benchmark.rows_from(Path('.pytest_cache/cna-measurements')/(shape+'.sqlite3'))\n    payload=list(row.payload)\n    payload[9]=payload[9].replace(b'\"high_points\":\"1.',b'\"high_points\":\"0.')\n    assert payload[9]!=row.payload[9]\n    invalid=replace(row,payload=tuple(payload))\n    del row,payload\n    gc.collect(); gc.disable(); tracemalloc.start()\n    outcome=failure_boundary._capture(iter((invalid,)),c_benchmark.CODES,lambda *a:None,{})\n    assert isinstance(outcome,failure_boundary.Failure)\n    before=tracemalloc.get_traced_memory()\n    collected=gc.collect(2)\n    after=tracemalloc.get_traced_memory()[0]\n    tracemalloc.stop();gc.enable()\n    results.append(dict(shape=shape,liveBeforeCollection=before[0],peak=before[1],collected=collected,liveAfterCollection=after))\nreport=dict(results=results,source=Path(__file__).read_text(encoding='utf8'),limits='One traced pass per shape, no wrapper raise, prebuilt input excluded, automatic GC disabled only in diagnostic process; real fixtures do not establish all error graphs are acyclic.')\nPath('.pytest_cache/native-next-retention-results.json').write_text(json.dumps(report,indent=2),encoding='utf8')\nprint(json.dumps(results,indent=2))\n",
