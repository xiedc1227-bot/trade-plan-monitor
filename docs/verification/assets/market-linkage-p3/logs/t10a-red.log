    def load_daily_draft_json(document):
        from trade_plan_monitor.domain.plan_codec import (
            _normalize_document,
            _reject_duplicate_json_keys,
            _reject_json_constant,
            _validate_data_tree,
        )

        raw = json.loads(
            _normalize_document(document),
            object_pairs_hook=_reject_duplicate_json_keys,
            parse_constant=_reject_json_constant,
        )
        if isinstance(raw, dict) and raw.get("schema_version") in {6, 7, 8}:
            from trade_plan_monitor.domain.market_linkage_validation import parse_current_draft

            _validate_data_tree(raw)
            return parse_current_draft(raw)
        if isinstance(raw, dict) and raw.get("schema_version") == 5:
