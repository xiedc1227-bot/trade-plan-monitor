                    "anyOf": [
                        {"$ref": "#/components/schemas/ReviewedPlanLibraryIdentity"},
                        {"type": "null"},
                    ],
                }
                current = current | {"properties": {
                    key: value for key, value in current["properties"].items() if key != "identity"
                }}
